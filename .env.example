NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated key for validated uploads
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Optional providers; use only after configuring their keys and consent flows
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_PRIMARY_PROVIDER=openrouter
AI_DAILY_LIMIT=3
AI_MAX_CONTEXT_MESSAGES=50
AI_FALLBACK_ENABLED=false
# Match the App Key's data center: SG, NA or SA
NEXCONN_REGION=SG
# Optional bearer secret for scheduled GET /api/chat/events
CRON_SECRET=
# Enable for controlled testing. The live two-user Nexconn acceptance gate remains separate.
AI_ENABLED=false
# Conservative budget reservations in millionths of USD. Configure from
# your provider prices and token bounds before enabling. Zero disables calls.
AI_DAILY_BUDGET_MICROS=0
AI_REQUEST_RESERVE_MICROS=100000
# Firebase web app, used for Authentication and browser Analytics
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
